MONGO_USER=root
MONGO_PASSWORD=root

# Postgres (общий инстанс: movies, theater, auth, booking, payment)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
# DB_PORT здесь НЕ задаём: Makefile выводит его из DB_HOST_PORT, а явное значение
# это перекрыло бы. Имена БД тоже не задаём — у каждого сервиса свой дефолт в
# application.yaml, а общий .env экспортируется во ВСЕ сервисы сразу.
# Раскомментируй, если 5432/6379 заняты нативными PostgreSQL/Redis на хосте.
# Тогда контейнеры поднимутся на других портах, и сервисам нужно передать
# DB_PORT/REDIS_PORT с теми же значениями.
# DB_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# Redis (auth-service: OTP + rate limit)
REDIS_PASSWORD=

# auth-service JWT
JWT_ISSUER=https://auth.cineflow.local
JWT_AUDIENCE=cineflow-api
JWT_KEY_ID=cineflow-dev-key

# Kafka (payment-service; позже booking). Один брокер KRaft в docker-compose.
# KAFKA_HOST_PORT — host-порт брокера (по образцу DB_HOST_PORT). Он же попадает в
# advertised listener брокера, поэтому менять его нужно только здесь: Makefile выведет
# KAFKA_BOOTSTRAP_SERVERS=localhost:<порт> для сервисов сам.
# KAFKA_HOST_PORT=9094
# Kafka UI (http://localhost:8090) — просмотр топиков и сообщений, только dev.
# KAFKA_UI_HOST_PORT=8090
