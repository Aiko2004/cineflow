MONGO_USER=root
MONGO_PASSWORD=root

# Postgres (общий инстанс: movies, theater, auth)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
# DB_PORT здесь НЕ задаём: Makefile выводит его из DB_HOST_PORT, а явное значение
# это перекрыло бы. Имена БД тоже не задаём — у каждого сервиса свой дефолт в
# application.yaml, а общий .env экспортируется во ВСЕ сервисы сразу.
# Раскомментируй, если 5432/6379 заняты нативными PostgreSQL/Redis на хосте.
# Тогда контейнеры поднимутся на других портах, и сервисам нужно передать
# DB_PORT/REDIS_PORT с теми же значениями.
# DB_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# Redis (auth-service: OTP + rate limit)
REDIS_PASSWORD=

# auth-service JWT
JWT_ISSUER=https://auth.cineflow.local
JWT_AUDIENCE=cineflow-api
JWT_KEY_ID=cineflow-dev-key
